# SSE Server Environment Configuration

# Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (same as dashboard_mvp)
DATABASE_URL=postgresql://username:password@localhost:5432/sse_dashboard

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# SSE Authentication
SSE_MASTER_KEY=your-secure-master-key-here-64-chars-minimum-change-in-production
APP_VERSION=1.0.0

# HTTPS Configuration
NODE_ENV=development
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key
CERT_FINGERPRINT=your-certificate-sha256-fingerprint-here

# File Paths (absolute paths for portability)
VISUALIZATIONS_DIR=./data/visualizations
TRADE_SIGNALS_DIR=./data/sim_trades

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Connection Limits
MAX_CONNECTIONS_PER_IP=5
CONNECTION_TIMEOUT_MS=300000

# Event Retention
EVENT_RETENTION_HOURS=24
CLEANUP_INTERVAL_HOURS=6
